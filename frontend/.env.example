# Frontend Environment Variables Template

# API URL
VITE_API_URL=http://localhost:3000/api

# Public patient/referring doctor portal origin used by QR codes and portal links.
# VITE_PORTAL_URL is supported as the primary portal origin.
VITE_PORTAL_URL=http://localhost:5174
VITE_PORTAL_PUBLIC_URL=http://localhost:5174

# App Configuration
VITE_APP_NAME=RCMS
VITE_APP_VERSION=2.0.0

# PACS diagnostic viewer (OHIF deployment URL).
# OHIF must be configured with a DICOMweb data source pointed at
# `${VITE_API_URL}/pacs/dicom-web` (the RCMS authenticated proxy to Orthanc).
# Leave blank until OHIF is deployed; the viewer route then shows a setup notice.
# VITE_OHIF_URL=http://localhost:3005

# Feature Flags (Optional)
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG=false
