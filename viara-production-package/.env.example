# =============================================================================
# VIARA RCMS — Environment Variables Template (.env.example)
# =============================================================================
# يُنسخ هذا القالب إلى .env عند التشغيل الأول وتُولّد الأسرار الفارغة تلقائياً.
# قبل التشغيل، أدخل مراجع الصور المثبتة والترخيص الصادر للعميل وإعدادات الموقع.
# =============================================================================

NODE_ENV=production
COMPOSE_PROJECT_NAME=viara-client

# Docker Images
VIARA_BACKEND_IMAGE=
VIARA_FRONTEND_IMAGE=
VIARA_PORTAL_IMAGE=
VIARA_OHIF_IMAGE=
POSTGRES_IMAGE=
CLAMAV_IMAGE=
ORTHANC_IMAGE=
CADDY_IMAGE=
REDIS_IMAGE=

# Ports
FRONTEND_PORT=5173
BACKEND_PORT=3000
PORTAL_PORT=5174
POSTGRES_PORT=5432
OHIF_PORT=3005
ORTHANC_REST_PORT=8042
PACS_DICOM_PORT=4242
PACS_DICOM_BIND=127.0.0.1

# Web services remain behind the edge. Set PACS_DICOM_BIND to the actual
# modality LAN interface and apply a per-device firewall allowlist.
# Host Bindings
FRONTEND_BIND=127.0.0.1
PORTAL_BIND=127.0.0.1

# URLs
CLIENT_URL=http://localhost:5173
PORTAL_CLIENT_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
WEBAUTHN_ORIGIN=http://localhost:5173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=VIARA Radiology Center
DOMAIN=localhost

# Frontend Build Configurations
PORTAL_PUBLIC_URL=http://localhost:5174
VITE_OHIF_URL=/pacs-viewer/
VITE_API_URL=/api

# Database
POSTGRES_USER=viara
POSTGRES_PASSWORD=
POSTGRES_DB=viara

# Cryptographic Keys & Secrets (auto-generated when left blank)
JWT_SECRET=
ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
METRICS_TOKEN=
REDIS_PASSWORD=

# Optional S3 offsite backups
BACKUP_OFFSITE_ENDPOINT=
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_REGION=us-east-1
BACKUP_OFFSITE_PREFIX=
BACKUP_OFFSITE_ACCESS_KEY=
BACKUP_OFFSITE_SECRET_KEY=

# PACS & DICOM
ORTHANC_USERNAME=VIARA
ORTHANC_PASSWORD=
ORTHANC_AET=ViaraPACS
PACS_WEBHOOK_SECRET=
PACS_CLOUD_IMAGE_DEIDENTIFICATION_VERIFIED=false
PACS_MWL_ENABLED=true
PACS_TIMEZONE=Africa/Cairo

# Client-specific signed license supplied through the approved delivery channel
LICENSE_KEY=
LICENSE_PING_ENABLED=false

# Hardening
RATE_LIMIT_STORE=redis
TRUST_PROXY=loopback,172.28.0.5,172.28.0.10,172.28.0.11
DB_POOL_MAX=20
PACS_AI_RELEASE_APPROVED=false

# WireGuard VPN (Optional Remote Teleradiology)
VPN_SERVER_URL=vpn.yourdomain.com
VPN_PORT=51820
VPN_PEERS=5
VPN_SUBNET=10.8.0.0/24
VPN_ALLOWED_IPS=
WIREGUARD_IMAGE=
TZ=Asia/Riyadh
