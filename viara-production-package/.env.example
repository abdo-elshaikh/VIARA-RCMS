# =============================================================================
# VIARA RCMS — Environment Variables Template (.env.example)
# =============================================================================

NODE_ENV=production
COMPOSE_PROJECT_NAME=viara-client

# Release images: use the exact vendor-approved immutable image references
# (prefer registry digests, e.g. registry.example/image@sha256:...).
VIARA_BACKEND_IMAGE=
VIARA_FRONTEND_IMAGE=
VIARA_PORTAL_IMAGE=
VIARA_OHIF_IMAGE=
POSTGRES_IMAGE=
CLAMAV_IMAGE=
ORTHANC_IMAGE=

# Ports
FRONTEND_PORT=5173
BACKEND_PORT=3000
PORTAL_PORT=5174
POSTGRES_PORT=5432
OHIF_PORT=3005
ORTHANC_REST_PORT=8042
PACS_DICOM_PORT=4242
PACS_DICOM_BIND=127.0.0.1

# URLs
# Runtime URLs
CLIENT_URL=
PORTAL_CLIENT_URL=
ALLOWED_ORIGINS=
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
DOMAIN=yourdomain.com    # نطاق الإنتاج الحقيقي — يُستخدم بواسطة Caddy لإصدار شهادة TLS تلقائياً

# Frontend build inputs are recorded for the release owner; editing these at
# runtime does not change the already-built frontend image. Build it with
# VITE_OHIF_URL=/pacs-viewer/ for same-origin OHIF embedding.
PORTAL_PUBLIC_URL=
VITE_OHIF_URL=/pacs-viewer/
VITE_API_URL=/api

# Database
# Use a unique 64-character hexadecimal password so the PostgreSQL URI remains valid.
POSTGRES_USER=viara
POSTGRES_PASSWORD=
POSTGRES_DB=viara

# Secrets (Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
# Optional OIDC validation for Weasis ViewerHub/Gateway DICOMweb requests.
# Leave unset until the identity provider, ViewerHub, and Gateway are configured.
# PACS_OIDC_ISSUER=https://identity.example.org/realms/viara
# PACS_OIDC_AUDIENCE=viara-pacs
# PACS_OIDC_JWKS_URL=https://identity.example.org/realms/viara/protocol/openid-connect/certs
# PACS_OIDC_USER_ID_CLAIM=viara_user_id
# PACS_OIDC_REQUIRED_SCOPE=pacs.read
# PACS_OIDC_MAX_TOKEN_TTL_SECONDS=300
ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
METRICS_TOKEN=REPLACE_ME_RANDOM_METRICS_TOKEN
# Optional encrypted backup replication to S3-compatible storage.
BACKUP_OFFSITE_ENDPOINT=
BACKUP_OFFSITE_BUCKET=
BACKUP_OFFSITE_REGION=us-east-1
BACKUP_OFFSITE_PREFIX=
BACKUP_OFFSITE_ACCESS_KEY=
BACKUP_OFFSITE_SECRET_KEY=
BLIND_INDEX_KEY=

# PACS
ORTHANC_USERNAME=VIARA
ORTHANC_PASSWORD=
ORTHANC_AET=MiPACS2
PACS_WEBHOOK_SECRET=
# Set true only after validating upstream removal of identifiers from rendered
# pixels (including burned-in text); DICOM tags do not prove pixel de-identification.
PACS_CLOUD_IMAGE_DEIDENTIFICATION_VERIFIED=false

# License Key (Base64url ECDSA P-256 signed payload provided by VIARA vendor)
LICENSE_KEY=

# ---------------------------------------------------------------------------
# Air-Gapped / Offline Deployment
# For deployments in isolated networks without internet access, set:
# LICENSE_PING_ENABLED=false
# This disables outbound license validation pings that would fail in air-gapped
# environments and cause startup errors or degraded functionality.
# ---------------------------------------------------------------------------
# LICENSE_PING_ENABLED=true

# Release hardening: shared quotas, trusted networks and explicit AI acceptance
RATE_LIMIT_STORE=redis
TRUST_PROXY=loopback,172.28.0.5
DB_POOL_MAX=20
PACS_AI_RELEASE_APPROVED=false
REDIS_IMAGE=REPLACE_ME_APPROVED_REDIS_IMAGE
REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_ME_REDIS_PASSWORD@redis:6379
