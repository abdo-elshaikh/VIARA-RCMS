POSTGRES_USER=VIARA
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=VIARA
POSTGRES_PORT=5432
NODE_ENV=development
JWT_SECRET=replace_with_a_generated_32_character_or_longer_secret
# Optional OIDC validation for Weasis ViewerHub/Gateway DICOMweb requests.
# Configure all three to enable; the access token must carry a VIARA user UUID
# in PACS_OIDC_USER_ID_CLAIM and the required scope.
# PACS_OIDC_ISSUER=https://identity.example.org/realms/viara
# PACS_OIDC_AUDIENCE=viara-pacs
# PACS_OIDC_JWKS_URL=https://identity.example.org/realms/viara/protocol/openid-connect/certs
# PACS_OIDC_USER_ID_CLAIM=viara_user_id
# PACS_OIDC_REQUIRED_SCOPE=pacs.read
# PACS_OIDC_MAX_TOKEN_TTL_SECONDS=300
# Local Keycloak values (development only; see docs/WEASIS_VIEWERHUB_INTEGRATION.md).
# PACS_OIDC_ISSUER=http://localhost:8081/realms/viara
# PACS_OIDC_AUDIENCE=viara-pacs
# PACS_OIDC_JWKS_URL=http://keycloak:8080/realms/viara/protocol/openid-connect/certs
# PACS_OIDC_USER_ID_CLAIM=viara_user_id
# PACS_OIDC_REQUIRED_SCOPE=pacs.read
# PACS_OIDC_MAX_TOKEN_TTL_SECONDS=300
# Local Keycloak is opt-in: docker compose --profile oidc-dev up -d keycloak
# Change this development-only password before starting the container.
KEYCLOAK_DEV_ADMIN_USERNAME=admin
KEYCLOAK_DEV_ADMIN_PASSWORD=replace_with_a_strong_local_only_password
# Optional override; pin an approved Keycloak image before using beyond local development.
# KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.3.3
# Optional dedicated key for signed, expiring public notification opt-out links.
# NOTIFICATION_UNSUBSCRIBE_SECRET=replace_with_a_generated_32_character_or_longer_secret
ENCRYPTION_KEY=replace_with_64_generated_hex_characters
DEVELOPER_EMAIL=
# ENCRYPTION_KEYS={}
# ENCRYPTION_KEY_ID=default
BACKUP_ENCRYPTION_KEY=replace_with_a_different_64_hex_character_key
BLIND_INDEX_KEY=replace_with_a_separate_generated_secret
CLIENT_URL=http://localhost:5173
PORTAL_CLIENT_URL=http://localhost:5174
PORTAL_PUBLIC_URL=http://localhost:5174
# Production public HTTPS API origin used for notification delivery receipts.
# PUBLIC_API_URL=https://api.example.com
# TWILIO_STATUS_CALLBACK_URL=https://api.example.com/api/webhooks/twilio
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
VITE_PORTAL_PUBLIC_URL=http://localhost:5174
BACKEND_BIND=127.0.0.1
BACKEND_PORT=3000
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=5173
PORTAL_BIND=127.0.0.1
PORTAL_PORT=5174
# Compose uses clamdscan over the private data network. Set this only for a
# non-Compose backend installation with a locally managed scanner executable.
CLAMSCAN_PATH=clamscan
MALWARE_SCAN_TIMEOUT_MS=30000

# --- AI report assistance (optional) ---
# Powers "Improve format" and optional language-model report drafting.
# Leave AI_API_KEY blank to disable the feature (the endpoints return 503).
#
# Built-in free-tier cloud providers (no GPU, no local worker required):
#   AI_PROVIDER=gemini       → Google Gemini Flash  (get key: https://aistudio.google.com)
#   AI_PROVIDER=openrouter   → OpenRouter auto      (get key: https://openrouter.ai)
#   AI_PROVIDER=groq         → Groq Cloud           (get key: https://console.groq.com)
#   AI_PROVIDER=anthropic    → Anthropic Claude     (paid, most accurate)
#   AI_PROVIDER=openai       → OpenAI GPT           (paid)
#
# AI_PROVIDER=gemini
# AI_API_KEY=                      # fallback key (used if provider-specific key not set)
# AI_MODEL=                        # leave blank to use the recommended default per provider
# AI_BASE_URL=                     # optional override for OpenAI-compatible gateways

# --- Free-tier cloud AI keys (no GPU, no local worker required) ---
# ⚠ Privacy: Only anonymised/de-identified pixel data is sent to cloud APIs.
#   Never configure these keys with systems that process real patient data on
#   the free tier without verifying the provider's data-use policy.
#
# Primary: Google Gemini Flash  (~1500 req/day free)
# GEMINI_API_KEY=                  # https://aistudio.google.com/app/apikey
# GEMINI_API_KEY_2=                # optional 2nd account key — doubles free quota
# GEMINI_API_KEY_3=                # optional 3rd account key — triples free quota
#
# Fallback: OpenRouter  (free model pool — auto-selects best vision model)
# OPENROUTER_API_KEY=              # https://openrouter.ai/keys
#
# Optional: Groq  (fastest inference, 14400 req/day free)
# GROQ_API_KEY=                    # https://console.groq.com/keys

# --- PACS image AI (job queue) ---
# Cloud image dispatch stays disabled until rendered-pixel de-identification has
# been validated operationally; DICOM tag checks alone cannot verify pixels.
# PACS_CLOUD_IMAGE_DEIDENTIFICATION_VERIFIED=false
# Set PACS_AI_PROVIDER=cloud-gemini to use built-in cloud dispatch
# (no PACS_AI_WORKER_URL needed; uses GEMINI_API_KEY + OPENROUTER_API_KEY above)
#
# PACS_AI_PROVIDER=cloud-gemini
# PACS_AI_ENABLED=false            # settings page value normally controls this
# PACS_AI_MODEL=densenet121-res224-all   # for local worker only
# PACS_AI_MODEL_REVISION=          # pin deployed model artifacts before validation
# PACS_AI_WORKER_URL=http://pacs-ai-worker:8000 # not needed for cloud-gemini
# PACS_AI_WORKER_API_KEY=          # generate at least 32 random bytes
# PACS_AI_WORKER_PORT=3015
# PACS_AI_MODEL_BACKEND=torchxrayvision # medgemma needs at least 12 GB VRAM
# PACS_AI_XRV_FINDING_THRESHOLD=0.65
# PACS_AI_PRELOAD_MODEL=false
# PACS_AI_ALLOW_CPU_INFERENCE=true    # reliable default for the lightweight CXR classifier
# PACS_AI_DOCKERFILE=Dockerfile.gpu   # optional large-GPU MedGemma deployment
# PACS_AI_WORKER_TIMEOUT_MS=600000
# PACS_AI_QUEUE_INTERVAL_MS=30000
# PACS_AI_QUEUE_BATCH_SIZE=1
# HF_TOKEN=                        # only needed for the optional MedGemma profile

# --- PACS / Orthanc (DICOM imaging core) ---
ORTHANC_URL=http://orthanc:8042
ORTHANC_USERNAME=VIARA
ORTHANC_PASSWORD=replace_with_a_strong_orthanc_password
ORTHANC_AET=MiPACS2
# LAN/VPN address modalities use for C-ECHO, C-STORE, and MWL. Use the server's real LAN IP.
PACS_SERVER_IP=127.0.0.1
# Bind to the modality VLAN/VPN interface explicitly in production.
PACS_DICOM_BIND=127.0.0.1
PACS_DICOM_PORT=4242
# Shared secret verified by the VIARA reconciler webhook (X-Pacs-Signature header)
PACS_WEBHOOK_SECRET=replace_with_a_separate_generated_secret
# Toggle the Modality Worklist .wl file generator
PACS_MWL_ENABLED=true
PACS_UPLOAD_TIMEOUT_MS=600000
DICOMWEB_TIMEOUT_MS=300000

# --- OHIF diagnostic viewer ---
# Port on which the OHIF container is exposed on the host (loopback-bound only).
# The SPA embeds OHIF in an iframe; the viewer's DICOMweb requests are proxied
# through the VIARA backend — Orthanc is never reachable from the browser.
OHIF_PORT=3005
VITE_OHIF_URL=http://localhost:3005

# -- License & Trial Edition --------------------------------------------------
# Required for all editions (trial, standard, enterprise).
# Generate with: node scripts/generate-license.js
LICENSE_KEY=

# Optional: override the embedded public key with a custom PEM (base64url encoded)
# Useful if you rotate keys between major versions.
# LICENSE_PUBLIC_KEY=

# How often the license ping job checks validity (default: 86400000 = 24h)
LICENSE_PING_INTERVAL_MS=86400000

# Optional cloud license server to PING (leave empty for offline/air-gapped installs)
LICENSE_PING_URL=
LICENSE_PING_ENABLED=true

# ---------------------------------------------------------------------------
# Air-Gapped / Offline Deployment
# For deployments in isolated networks without internet access, set:
# LICENSE_PING_ENABLED=false
# This disables outbound license validation pings that would fail in air-gapped
# environments and cause startup errors or degraded functionality.
# ---------------------------------------------------------------------------
# LICENSE_PING_ENABLED=true

# -- Weekly Trial Sales Digest -------------------------------------------------
# Trial editions only. Sends the sales team one engagement digest per window
# (features used, features blocked by the license, quota pressure) so prospects
# can be ranked by real activity.
# Comma-separated. Leave empty to disable the job entirely.
TRIAL_REPORT_TO=

# How often the digest is sent (default: 604800000 = 7 days)
TRIAL_REPORT_INTERVAL_MS=604800000

# Set to "false" to disable the weekly digest
TRIAL_REPORT_ENABLED=true

# -- Upgrade & Sales CTA URLs -------------------------------------------------
# These appear in the TrialBanner, FeatureLocked, and Onboarding wizard.
UPGRADE_URL=https://viara.net/upgrade
SALES_CONTACT_URL=https://viara.net/contact

# Original DICOM companions are mandatory for complete production backups.
PACS_BACKUP_ENABLED=true
PACS_TIMEZONE=Africa/Cairo
# Local Windows backend: set an absolute path on a durable encrypted volume.
# Docker backend uses its named pacs_cold_archive volume at /app/pacs-cold.
PACS_COLD_STORAGE_DIR=

# Release hardening: shared quotas, trusted networks and explicit AI acceptance
RATE_LIMIT_STORE=redis
TRUST_PROXY=loopback,linklocal,uniquelocal
DB_POOL_MAX=20
PACS_AI_RELEASE_APPROVED=false

REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD

METRICS_TOKEN=REPLACE_ME_RANDOM_METRICS_TOKEN

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=    # Grafana admin password (required in production)
GF_SECURITY_SECRET_KEY=    # Grafana encryption key (32+ chars, required in production)
GRAFANA_PORT=3010          # Local port for Grafana UI
GRAFANA_ROOT_URL=          # Public URL of Grafana (e.g. https://monitoring.example.com)
