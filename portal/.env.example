VITE_API_URL=http://localhost:3000/api
VITE_ADMIN_APP_URL=http://localhost:5173
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Public origin used to build absolute Open Graph URLs (og:image, og:url).
# Leave empty in local dev; set to the deployed origin in production builds,
# e.g. VITE_SITE_URL=https://portal.viara.example
VITE_SITE_URL=

# Used only by Vite dev proxy. Production builds should use VITE_API_URL.
API_PROXY_TARGET=http://localhost:3000
