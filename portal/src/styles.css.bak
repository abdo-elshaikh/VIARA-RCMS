@import "tailwindcss";
@source "../src";
@import "tw-animate-css";

/*
 * RCMS Portal Design System
 * Direction: clinical radiology portal.
 * Calm surfaces, precise contrast, scan-inspired gradients, and resilient responsive UI.
 */

@theme inline {
  --font-display: "Outfit", "Cairo", ui-sans-serif, system-ui, sans-serif;
  --font-sans: "Inter", "Cairo", ui-sans-serif, system-ui, sans-serif;
  --font-mono: "JetBrains Mono", "Cascadia Mono", ui-monospace, monospace;

  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
  --radius-2xl: calc(var(--radius) + 8px);
  --radius-3xl: calc(var(--radius) + 14px);

  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-primary-soft: var(--primary-soft);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-success: var(--success);
  --color-warning: var(--warning);
  --color-info: var(--info);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-surface: var(--surface);
  --color-surface-alt: var(--surface-alt);
  --color-ink: var(--ink);
  --color-ink-soft: var(--ink-soft);
}

:root {
  --radius: 0.75rem;

  --background: #f4f7fa;
  --foreground: #0b192a;
  --surface: #ffffff;
  --surface-alt: #eaf1f5;
  --ink: #0b192a;
  --ink-soft: #52657a;

  --card: #ffffff;
  --card-foreground: #0b192a;
  --popover: #ffffff;
  --popover-foreground: #0b192a;

  --primary: #075f7b;
  --primary-foreground: #ffffff;
  --primary-soft: #dff1f5;
  --secondary: #e7eff3;
  --secondary-foreground: #173449;
  --muted: #e7edf2;
  --muted-foreground: #5c6e81;

  --accent: #0ea99d;
  --accent-foreground: #ffffff;
  --destructive: #c2413b;
  --destructive-foreground: #ffffff;
  --success: #148c63;
  --warning: #f3b64d;
  --info: #4b76d1;

  --border: #d5e0e7;
  --input: #bdced9;
  --ring: #52b7c8;

  --gradient-hero:
    radial-gradient(circle at 18% 16%, rgba(34, 211, 189, 0.22), transparent 34%),
    linear-gradient(135deg, #082f49 0%, #075f7b 52%, #0d9488 100%);
  --gradient-accent: linear-gradient(135deg, #075f7b 0%, #0ea99d 100%);
  --gradient-mesh:
    radial-gradient(circle at 12% 18%, rgba(62, 180, 198, 0.18), transparent 29%),
    radial-gradient(circle at 82% 8%, rgba(14, 169, 157, 0.13), transparent 26%),
    linear-gradient(180deg, #f8fafc 0%, #eaf3f6 100%);

  --shadow-soft: 0 8px 24px rgba(11, 25, 42, 0.07);
  --shadow-elevated: 0 20px 55px rgba(11, 25, 42, 0.13);
  --shadow-glow: 0 20px 60px rgba(7, 95, 123, 0.18);
}

.dark {
  --background: #07111d;
  --foreground: #edf7ff;
  --surface: #0d1b2a;
  --surface-alt: #12263a;
  --ink: #edf7ff;
  --ink-soft: #aac0d2;

  --card: #0d1b2a;
  --card-foreground: #edf7ff;
  --popover: #0d1b2a;
  --popover-foreground: #edf7ff;
  --primary: #4fb3f6;
  --primary-foreground: #06101b;
  --primary-soft: #102f48;
  --secondary: #12263a;
  --secondary-foreground: #edf7ff;
  --muted: #162b40;
  --muted-foreground: #a9bbcc;

  --accent: #30d2c9;
  --accent-foreground: #06101b;
  --destructive: #f87171;
  --destructive-foreground: #06101b;
  --success: #35d399;
  --warning: #facc6b;
  --info: #83a8ff;

  --border: #23394f;
  --input: #33516a;
  --ring: #4fb3f6;

  --gradient-mesh:
    radial-gradient(circle at 18% 20%, rgba(79, 179, 246, 0.18), transparent 32%),
    radial-gradient(circle at 78% 8%, rgba(48, 210, 201, 0.14), transparent 26%),
    linear-gradient(180deg, #07111d 0%, #0d1b2a 100%);
  --shadow-soft: 0 12px 32px rgba(0, 0, 0, 0.26);
  --shadow-elevated: 0 22px 58px rgba(0, 0, 0, 0.34);
  --shadow-glow: 0 20px 70px rgba(79, 179, 246, 0.22);
}

@layer base {
  * {
    border-color: var(--color-border);
  }

  html {
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  body {
    min-width: 320px;
    overflow-x: hidden;
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-sans);
    font-feature-settings:
      "ss01" on,
      "cv01" on;
    -webkit-font-smoothing: antialiased;
  }

  ::selection {
    background: color-mix(in oklab, var(--accent) 24%, transparent);
    color: var(--foreground);
  }

  h1,
  h2,
  h3,
  h4,
  h5 {
    font-family: var(--font-display);
    letter-spacing: 0;
  }

  button,
  a,
  input,
  select,
  textarea {
    text-underline-offset: 3px;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  :focus-visible {
    outline: 3px solid color-mix(in oklab, var(--ring) 50%, transparent);
    outline-offset: 2px;
  }

  input,
  select,
  textarea {
    font-size: max(1rem, 16px);
  }
}

.gradient-hero {
  background: var(--gradient-hero);
  background-color: var(--primary);
}

.gradient-accent {
  background: var(--gradient-accent);
  background-color: var(--accent);
}

.gradient-mesh {
  background: var(--gradient-mesh);
}

.shadow-soft {
  box-shadow: var(--shadow-soft);
}

.shadow-elevated {
  box-shadow: var(--shadow-elevated);
}

.shadow-glow {
  box-shadow: var(--shadow-glow);
}

.text-balance {
  text-wrap: balance;
}

.grid-pattern {
  background-image:
    linear-gradient(rgba(7, 95, 123, 0.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(7, 95, 123, 0.055) 1px, transparent 1px);
  background-size: 40px 40px;
}

.clinical-wash {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.92)),
    var(--gradient-mesh);
}

.portal-card {
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--surface);
  box-shadow: var(--shadow-soft);
}

.portal-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-elevated);
}

.portal-button {
  border: 1px solid transparent;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-soft);
  transition:
    transform 160ms ease,
    box-shadow 160ms ease,
    background-color 160ms ease,
    border-color 160ms ease;
}

.portal-button:hover {
  transform: translateY(-1px);
  box-shadow: var(--shadow-elevated);
}

.portal-button:active {
  transform: translateY(0);
  box-shadow: var(--shadow-soft);
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.42rem 0.8rem;
  border: 1px solid color-mix(in oklab, var(--primary) 18%, var(--border));
  border-radius: var(--radius-md);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  background: var(--primary-soft);
  color: var(--primary);
}

.workspace-shell {
  min-height: 100vh;
  overflow-x: clip;
  background:
    linear-gradient(
      90deg,
      color-mix(in oklab, var(--primary) 3%, transparent) 1px,
      transparent 1px
    ),
    linear-gradient(color-mix(in oklab, var(--primary) 3%, transparent) 1px, transparent 1px),
    linear-gradient(
      180deg,
      var(--background),
      color-mix(in oklab, var(--surface-alt) 62%, var(--background))
    );
  background-size:
    48px 48px,
    48px 48px,
    auto;
}

.workspace-header {
  border-bottom: 1px solid color-mix(in oklab, var(--border) 86%, transparent);
  background: color-mix(in oklab, var(--surface) 90%, transparent);
  box-shadow: 0 4px 22px rgba(11, 25, 42, 0.055);
}

.workspace-layout {
  align-items: start;
}

.workspace-sidebar {
  border-radius: var(--radius-lg);
  box-shadow: 0 8px 28px rgba(11, 25, 42, 0.065);
}

.workspace-content > section,
.workspace-content > div {
  scroll-margin-top: 6rem;
}

.workspace-hero {
  min-height: 14.5rem;
  border-radius: calc(var(--radius) + 0.35rem);
}

.mobile-dock {
  scrollbar-width: none;
}

.mobile-dock::-webkit-scrollbar {
  display: none;
}

@media (max-width: 639px) {
  .workspace-hero {
    min-height: auto;
  }

  [role="dialog"] {
    max-height: min(88dvh, 48rem);
    overflow-y: auto;
  }
}

.fade-in-up {
  animation: fadeInUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.animate-float {
  animation: float 5.5s ease-in-out infinite;
}

.animate-float-slow {
  animation: float 8s ease-in-out infinite;
}

.animate-blob {
  animation: none;
}

.animate-scan {
  animation: scan 3.2s ease-in-out infinite;
}

.animate-orbit {
  animation: orbit 18s linear infinite;
}

.animate-pulse-ring {
  animation: pulseRing 2.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

.animate-marquee {
  animation: marquee 32s linear infinite;
}

.animate-gradient-x {
  background-size: 200% 200%;
  animation: gradientX 8s ease infinite;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(16px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-10px);
  }
}

@keyframes scan {
  0% {
    transform: translateY(-100%);
    opacity: 0;
  }

  10%,
  90% {
    opacity: 1;
  }

  100% {
    transform: translateY(100%);
    opacity: 0;
  }
}

@keyframes orbit {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes pulseRing {
  0% {
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--primary) 24%, transparent);
  }

  70% {
    box-shadow: 0 0 0 16px transparent;
  }

  100% {
    box-shadow: 0 0 0 0 transparent;
  }
}

@keyframes marquee {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }
}

@keyframes marquee-rtl {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(50%);
  }
}

@keyframes gradientX {
  0%,
  100% {
    background-position: 0% 50%;
  }

  50% {
    background-position: 100% 50%;
  }
}

[dir="rtl"] .animate-marquee,
html[dir="rtl"] .animate-marquee {
  animation-name: marquee-rtl;
}

.gradient-text {
  background-image: linear-gradient(90deg, var(--primary), var(--accent));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}

.gradient-text-animated {
  background-image: linear-gradient(90deg, var(--primary), var(--accent), var(--primary));
  background-size: 240% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
  animation: gradientX 8s ease infinite;
}

@media (prefers-reduced-motion: reduce) {
  .animate-float,
  .animate-float-slow,
  .animate-scan,
  .animate-orbit,
  .animate-pulse-ring,
  .animate-marquee,
  .animate-gradient-x,
  .gradient-text-animated,
  .fade-in-up,
  .stagger-in {
    animation: none !important;
  }
}

.skeleton {
  position: relative;
  overflow: hidden;
  background: var(--surface-alt);
  border-radius: var(--radius-lg);
}

.skeleton::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.45) 50%,
    transparent 100%
  );
  animation: shimmer 1.8s ease-in-out infinite;
}

@keyframes shimmer {
  0% {
    transform: translateX(-100%);
  }

  100% {
    transform: translateX(100%);
  }
}

.stagger-in > * {
  animation: fadeInUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.stagger-in > *:nth-child(1) {
  animation-delay: 0ms;
}
.stagger-in > *:nth-child(2) {
  animation-delay: 60ms;
}
.stagger-in > *:nth-child(3) {
  animation-delay: 120ms;
}
.stagger-in > *:nth-child(4) {
  animation-delay: 180ms;
}
.stagger-in > *:nth-child(5) {
  animation-delay: 240ms;
}
.stagger-in > *:nth-child(6) {
  animation-delay: 300ms;
}

.faq-answer {
  overflow: hidden;
  animation: faqExpand 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes faqExpand {
  from {
    opacity: 0;
    max-height: 0;
  }

  to {
    opacity: 1;
    max-height: 300px;
  }
}

.safe-area-bottom {
  padding-bottom: max(0.75rem, env(safe-area-inset-bottom, 0.75rem));
}

html[lang="ar"] body {
  font-family: "Cairo", "Inter", ui-sans-serif, system-ui, sans-serif;
}

html[lang="ar"] {
  --font-display: "Cairo", "Inter", ui-sans-serif, system-ui, sans-serif;
}

[dir="rtl"] .rotate-on-rtl {
  transform: scaleX(-1);
}

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--surface-alt);
}

::-webkit-scrollbar-thumb {
  background: color-mix(in oklab, var(--primary) 70%, var(--border));
  border-radius: 9999px;
}
