backend/backups/
*.dump

# Patient documents & chat attachments (PHI) must never be committed
backend/uploads/

*.playwright-mcp
*.kilo

# Local archives and editor/OS artifacts
*.bak
*.tmp
*.rar
*.zip
*.7z
desktop.ini

# Scratch, local caches, and test artifacts
scratch/
portal/unused-images/
pacs-worklists/*.wl
!pacs-worklists/.gitkeep
/ChatGPT Image*
/*.png

# License keys — NEVER commit these
keys/privateKey.pem
keys/
.viara-activation
.viara-license
client_license_*.txt

