{
  "Name": "MiPACS2",
  "//": "VIARA custom PACS core. Secrets (PostgreSQL password, RegisteredUsers) are injected at runtime via ORTHANC__* environment variables in docker-compose and MUST NOT be committed here.",
  "DicomAet": "MiPACS2",
  "DicomPort": 4242,
  "HttpPort": 8042,
  "DicomCheckCalledAet": true,
  "DicomAlwaysAllowEcho": true,
  "DicomAlwaysAllowStore": false,
  "//dicomAccess": "Unknown modalities may verify connectivity only. Store, worklist and retrieval require a configured calling AET and matching host. Devices must address the configured called AET.",
  "DicomAlwaysAllowFind": false,
  "DicomAlwaysAllowFindWorklist": false,
  "DicomAlwaysAllowMove": false,
  "DicomCheckModalityHost": true,
  "LimitFindResults": 100,
  "LimitFindInstances": 1000,
  "UnknownSopClassAccepted": true,
  "//storage": "Orthanc index lives in its dedicated PostgreSQL database; pixel data stays on the mounted volume.",
  "StorageDirectory": "/var/lib/orthanc/db",
  "IndexDirectory": "/var/lib/orthanc/db",
  "//auth": "HTTP REST is reached only from inside the compose network via the VIARA proxy. Basic-auth is still required; RegisteredUsers is supplied through ORTHANC__REGISTERED_USERS__* env.",
  "AuthenticationEnabled": true,
  "RemoteAccessAllowed": true,
  "//plugins": "orthancteam/orthanc bundles these .so files.",
  "Plugins": [
    "/usr/share/orthanc/plugins",
    "/usr/local/share/orthanc/plugins"
  ],
  "PostgreSQL": {
    "EnableIndex": true,
    "EnableStorage": false,
    "Host": "postgres",
    "Port": 5432,
    "Database": "orthanc",
    "Username": "VIARA",
    "Lock": false
  },
  "DicomWeb": {
    "Enable": true,
    "Root": "/dicom-web/",
    "EnableWado": true,
    "WadoRoot": "/wado",
    "Ssl": false,
    "StudiesMetadata": "Full",
    "SeriesMetadata": "Full"
  },
  "Worklists": {
    "Enable": true,
    "//": "VIARA pacsMwlService writes .wl files here; this volume is shared with the backend container.",
    "Database": "/var/lib/orthanc/worklists"
  },
  "//modalities": "AET -> host/port map for C-MOVE/C-STORE back to consoles. Extend per site.",
  "DicomModalities": {
    "ct_room_1": {
      "AET": "CT_ROOM_1",
      "Host": "127.0.0.1",
      "Port": 104,
      "AllowEcho": true,
      "AllowStore": true,
      "AllowFind": false,
      "AllowFindWorklist": true,
      "AllowMove": false,
      "AllowGet": false
    },
    "mri_room_1": {
      "AET": "MRI_ROOM_1",
      "Host": "127.0.0.1",
      "Port": 104,
      "AllowEcho": true,
      "AllowStore": true,
      "AllowFind": false,
      "AllowFindWorklist": true,
      "AllowMove": false,
      "AllowGet": false
    },
    "xray_room_1": {
      "AET": "XRAY_ROOM_1",
      "Host": "127.0.0.1",
      "Port": 104,
      "AllowEcho": true,
      "AllowStore": true,
      "AllowFind": false,
      "AllowFindWorklist": true,
      "AllowMove": false,
      "AllowGet": false
    },
    "ultrasound_room_1": {
      "AET": "ULTRASOUND_ROOM_1",
      "Host": "127.0.0.1",
      "Port": 104,
      "AllowEcho": true,
      "AllowStore": true,
      "AllowFind": false,
      "AllowFindWorklist": true,
      "AllowMove": false,
      "AllowGet": false
    }
  },
  "//lua": "OnStoredInstance -> shared-secret (X-Pacs-Signature) webhook to the VIARA reconciler.",
  "LuaScripts": [
    "/etc/orthanc/reconcile.lua"
  ],
  "OverwriteInstances": false
}
