{
    "name": "VIARA-backend",
    "version": "1.0.0",
    "description": "Radiology Center Management System API",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "node --watch src/server.js",
        "migrate": "node ../database/migrate.js",
        "ai:worker": "powershell -NoProfile -ExecutionPolicy Bypass -File ../pacs/ai-worker/start-local.ps1 -PreloadModel",
        "test": "cross-env NODE_ENV=test jest",
        "test:ci": "cross-env NODE_ENV=test jest --ci --runInBand",
        "backup:decrypt": "node scripts/decryptBackup.js",
        "create:developer": "node scripts/createDeveloper.js",
        "rotate-encryption": "node scripts/reencryptData.js",
        "validate-deployment": "node scripts/validateDeployment.js",
        "reset-demo-accounts": "node scripts/resetDemoAccounts.js"
    },
    "dependencies": {
        "@simplewebauthn/server": "^13.2.2",
        "adm-zip": "^0.6.1",
        "bcrypt": "^6.0.0",
        "compression": "^1.8.2",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "csv-parser": "^3.2.1",
        "dcmjs": "^0.44.1",
        "decimal.js": "^10.6.0",
        "dotenv": "^16.4.5",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "helmet": "^7.1.0",
        "jpeg-lossless-decoder-js": "^2.1.2",
        "json2csv": "^6.0.0-alpha.2",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^10.0.9",
        "opossum": "^9.0.0",
        "otplib": "^12.0.1",
        "p-limit": "^3.1.0",
        "pdfkit": "^0.17.2",
        "pg": "^8.11.3",
        "prom-client": "^15.1.3",
        "proxy-addr": "^2.0.8",
        "qrcode": "^1.5.3",
        "rate-limit-redis": "^4.3.1",
        "redis": "^5.12.1",
        "stripe": "^12.18.0",
        "twilio": "^6.0.2",
        "winston": "^3.19.0",
        "yauzl": "^3.4.0",
        "yazl": "^3.3.1",
        "zod": "^3.22.4"
