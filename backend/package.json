{
  "name": "rcms-backend",
  "version": "1.0.0",
  "description": "Radiology Center Management System API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node ../database/migrate.js",
    "ai:worker": "powershell -NoProfile -ExecutionPolicy Bypass -File ../pacs/ai-worker/start-local.ps1 -PreloadModel",
    "test": "cross-env NODE_ENV=test jest",
    "test:ci": "cross-env NODE_ENV=test jest --ci --runInBand",
    "backup:decrypt": "node scripts/decryptBackup.js",
    "create:developer": "node scripts/createDeveloper.js",
    "rotate-encryption": "node scripts/reencryptData.js",
    "validate-deployment": "node scripts/validateDeployment.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.6",
    "csv-parser": "^3.2.1",
    "dcmjs": "^0.44.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.1.0",
    "jpeg-lossless-decoder-js": "^2.1.2",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.1",
    "opossum": "^9.0.0",
    "otplib": "^12.0.1",
    "pg": "^8.11.3",
    "p-limit": "^3.1.0",
    "qrcode": "^1.5.3",
    "stripe": "^12.18.0",
    "twilio": "^6.0.2",
    "winston": "^3.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  }
}
