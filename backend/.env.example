# VIARA Environment Variables Template

# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://VIARA:replace_me@localhost:5432/VIARA
# Optional first technical super-user bootstrap. Email-only promotes an existing
# active user; setting a strong password creates/resets the account.
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=
DEVELOPER_FULL_NAME=System Developer
DEVELOPER_FORCE_PASSWORD_CHANGE=true

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_generated_secret
# Governed emergency access duration; runtime clamps values to 15-120 minutes.
BREAK_GLASS_DURATION_MINUTES=60
# Optional dedicated key for signed, expiring public notification opt-out links.
# Defaults to JWT_SECRET when omitted. Generate and rotate it like JWT_SECRET.
# NOTIFICATION_UNSUBSCRIBE_SECRET=replace_with_a_generated_secret

# Encryption (MUST be 64 hex characters = 32 bytes for AES-256)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64_generated_hex_characters
# Optional rotation keyring, for example: {"2026-07":"<64 hex>"}
# ENCRYPTION_KEYS={}
# ENCRYPTION_KEY_ID=default

# Optional separate HMAC key for new deployments. Rotating this value requires
# rebuilding blind indexes in a controlled migration.
BLIND_INDEX_KEY=replace_with_a_separate_generated_secret
BACKUP_ENCRYPTION_KEY=replace_with_a_different_64_hex_character_key

# Frontend/CORS
CLIENT_URL=http://localhost:5173
PORTAL_CLIENT_URL=http://localhost:5174
# Add every browser origin that should call the API in production, for example:
# ALLOWED_ORIGINS=https://admin.example.com,https://portal.example.com
# Local development automatically allows the common Vite/OHIF ports 5173, 5174, and 3005.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Required in production. Path to the ClamAV clamscan executable.
CLAMSCAN_PATH=clamscan
# Required when using a network clamd service; readiness sends a PING here.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
MALWARE_SCAN_TIMEOUT_MS=30000

# AI report assistance (optional)
# Powers "Improve format" and optional language-model report drafting.
# Leave AI_API_KEY blank to disable the feature (the endpoints return 503).
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=claude-3-5-sonnet-latest
# AI_BASE_URL=
# Direct OpenAI profiles can be configured in Settings > AI providers.
# Optional environment fallback for both OpenAI report and PACS profiles:
# AI_PROVIDER=openai
# AI_MODEL=gpt-5.6-terra
# OPENAI_API_KEY=
# PACS_AI_PROVIDER=local-torchxrayvision
# PACS_AI_ENABLED=false
# PACS_AI_MODEL=densenet121-res224-all
# PACS_AI_MODEL_VERSION=<tested-hugging-face-commit>
# PACS_AI_WORKER_URL=http://localhost:3015
# PACS_AI_API_KEY=<same-value-as-PACS_AI_WORKER_API_KEY>
# PACS_AI_WORKER_TIMEOUT_MS=600000
# PACS_AI_QUEUE_INTERVAL_MS=30000
# PACS_AI_QUEUE_BATCH_SIZE=1
# Optional cloud PACS image request guardrails. Inline bytes count base64 payload
# size, so they are larger than the rendered JPEG/PNG bytes.
# PACS_AI_MAX_CLOUD_IMAGES=12
# PACS_AI_MAX_CLOUD_IMAGE_BYTES=4194304
# PACS_AI_MAX_CLOUD_TOTAL_IMAGE_BYTES=12582912
# PACS_AI_PROVIDER_TIMEOUT_MS=30000
# PACS_AI_ORTHANC_PREVIEW_TIMEOUT_MS=20000
# Cloud image analysis is blocked by default. Set true only after a validated
# upstream pipeline de-identifies rendered pixels, including burned-in identifiers.
# DICOM tags are still checked and do not prove that pixel contents were scrubbed.
# PACS_CLOUD_IMAGE_DEIDENTIFICATION_VERIFIED=false

# Logging
LOG_LEVEL=info

# PACS / Orthanc
ORTHANC_API_URL=http://127.0.0.1:8042
ORTHANC_USERNAME=VIARA
ORTHANC_PASSWORD=replace_with_a_strong_orthanc_password
ORTHANC_AET=MiPACS2
PACS_SERVER_IP=127.0.0.1
# Optional: set when the backend should test DICOM on a different host than ORTHANC_API_URL.
# Examples: 127.0.0.1 for local Orthanc, orthanc for Docker Compose, or a LAN/VPN host.
ORTHANC_DICOM_HOST=127.0.0.1
PACS_DICOM_PORT=4242
PACS_WEBHOOK_SECRET=replace_with_a_separate_generated_secret
PACS_MWL_ENABLED=true
PACS_TIERING_ENABLED=true
PACS_TIERING_DAYS=90
PACS_TIERING_BATCH=500
PACS_TIERING_INTERVAL_MS=3600000
PACS_COLD_PREFIX=s3://VIARA-pacs-cold
PACS_UPLOAD_TIMEOUT_MS=600000
DICOMWEB_TIMEOUT_MS=300000

# Shift guard (abandoned attendance sessions and reception shifts)
# SHIFT_GUARD_ENABLED=true
# SHIFT_GUARD_INTERVAL_MS=900000
# ATTENDANCE_STALE_HOURS=24
# RECEPTION_SHIFT_ABANDONED_MINUTES=45

# Backups
# Use "json" only for development snapshots; production should use "postgres".
BACKUP_MODE=json
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
PUBLIC_APPOINTMENT_RETENTION_DAYS=365
BACKUP_MAX_FILES=30
BACKUP_SCHEDULE_ENABLED=false
BACKUP_SCHEDULE_HOUR_UTC=2
# Offsite replication (optional — requires aws CLI v2 installed in the container)
# When configured, each encrypted backup is synced to the S3-compatible target
# after creation. Leave unset to skip replication (local-only retention applies).
# BACKUP_OFFSITE_ENDPOINT=s3.us-east-1.amazonaws.com
# BACKUP_OFFSITE_BUCKET=VIARA-backups-prod
# BACKUP_OFFSITE_REGION=us-east-1
# BACKUP_OFFSITE_PREFIX=database
# BACKUP_OFFSITE_ACCESS_KEY=
# BACKUP_OFFSITE_SECRET_KEY=
# Development/staging JSON restore only. Production PostgreSQL restores use the runbook.
BACKUP_JSON_RESTORE_ENABLED=true
BACKUP_JSON_RESTORE_MAX_BYTES=52428800
# PG_DUMP_PATH=pg_dump
# PG_RESTORE_PATH=pg_restore

# Email (Optional - for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@example.com

# SMS / WhatsApp (Optional - omit provider values to use development stubs)
# SMS_PROVIDER=twilio
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+15551234567
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public HTTPS API origin used for provider delivery callbacks.
# PUBLIC_API_URL=https://api.example.com
# Optional full override; defaults to PUBLIC_API_URL/api/webhooks/twilio.
# TWILIO_STATUS_CALLBACK_URL=https://api.example.com/api/webhooks/twilio

# Admin utility (Optional - scripts/createAdmin.js)
# ADMIN_EMAIL=superadmin@VIARA.com
# ADMIN_PASSWORD=Choose-A-Strong-Password1

# Release hardening: shared quotas, trusted networks and explicit AI acceptance
RATE_LIMIT_STORE=redis
TRUST_PROXY=loopback,linklocal,uniquelocal
DB_POOL_MAX=20
PACS_AI_RELEASE_APPROVED=false

REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD

METRICS_TOKEN=REPLACE_ME_RANDOM_METRICS_TOKEN
